# ==============================================================================
# Alibaba Cloud MaxCompute Credentials
# ==============================================================================
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here
ALIBABA_CLOUD_REGION=cn-shanghai
MAXCOMPUTE_PROJECT=on_mc_prod
MAXCOMPUTE_ENDPOINT=https://service.cn-shanghai.maxcompute.aliyun.com/api

# If deploying in Alibaba Cloud VPC (ECS / FC / SAE), use private endpoint to save costs and reduce latency:
# MAXCOMPUTE_ENDPOINT=http://service.cn-shanghai.maxcompute.aliyun-inc.com/api

# ==============================================================================
# MCP Server Settings
# ==============================================================================
MCP_TRANSPORT=sse
HOST=0.0.0.0
PORT=8000

# Recommended: Protect your remote SSE endpoint with a Bearer Token
MCP_AUTH_TOKEN=your_random_secret_token_here

# ==============================================================================
# Optional: Bailian API (Only needed if using local CLI simulator chat.py)
# ==============================================================================
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen3.8-flash
